# Copy to .env next to docker-compose.yml on the Paperless Docker VM and fill in.
# Never commit the real .env. See services/paperless-ngx/README.md.

# --- Identity -----------------------------------------------------------------
# UID/GID of the dedicated `paperless` DSM user (run `id paperless` over SSH on
# the Synology). Must match, because the NFS rules use "No mapping".
# DSM assigns the UID when the account is created: fill in the real value.
PAPERLESS_UID=
PAPERLESS_GID=100

# IANA time zone name, e.g. Area/City
TZ=Europe/Zurich

# --- Access ---------------------------------------------------------------------
# Port published on the VM (8000 for the live stack)
PAPERLESS_PORT=8000
# Address used in the browser and the phone app, no trailing slash. Sets
# Django's allowed hosts / CSRF origins. Update if a hostname or HTTPS is added.
PAPERLESS_URL=http://192.168.0.33:8000

# --- Secrets (generate, store in the password manager) -------------------------
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=
POSTGRES_PASSWORD=

# --- Paths on the VM ----------------------------------------------------------
# Local: database, broker, search index, consume folder (VM disk, not NFS)
APPDATA=/docker/appdata/paperless
# Subfolder of the NFS mount of the Synology `paperless` share
MEDIA=/mnt/paperless/media
# Subfolder of the NFS mount of the Synology `paperless_backups` share
EXPORT=/mnt/paperless_backups/export

# --- Pinned image tags ----------------------------------------------------------
# Pin exact tags and update deliberately: see README.md "Updating image tags".
# Run the nightly export (or a manual one) before every Paperless update.
PAPERLESS_TAG=3.3.0
# Major version only: minor updates are safe, a major change needs a dump/restore
POSTGRES_TAG=18
VALKEY_TAG=9-alpine
GOTENBERG_TAG=8.37
TIKA_TAG=3.3.1.0
