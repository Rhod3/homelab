# Copy to .env next to docker-compose.yml on the Arr Docker VM and fill in.
# Never commit the real .env. See services/arr-stack/README.md.

# --- Identity -----------------------------------------------------------------
# UID/GID of the dedicated `arr` DSM user (run `id arr` over SSH on the Synology).
# Must match, because the NFS rule uses "No mapping".
PUID=1030
PGID=100

# IANA time zone name, e.g. Area/City
TZ=Europe/Zurich

# --- Paths on the VM ----------------------------------------------------------
# Local app config/databases (VM disk, not NFS)
APPDATA=/docker/appdata
# NFS mount of the Synology `tv` share (torrents/ + media/)
DATA=/data

# --- VPN (qBittorrent) --------------------------------------------------------
# LAN allowed to reach the qBittorrent Web UI through hotio's VPN firewall
LAN_SUBNET=192.168.0.0/24
# Proton VPN (paid plan). Config file: ${APPDATA}/qbittorrent/wireguard/wg0.conf,
# generated in the Proton account with NAT-PMP (port forwarding) enabled.
VPN_PROVIDER=proton
# hotio requests the forwarded port from Proton and sets qBittorrent's listening port
VPN_AUTO_PORT_FORWARD=true

# --- Pinned image tags ----------------------------------------------------------
# Versions currently deployed. Pin exact tags only and update deliberately, one
# app at a time: see README.md "Updating image tags" for the lookup command.
# hotio tags look like `release-<version>` (never the -linux-arm64/-amd64 ones).
PROWLARR_TAG=release-2.6.5.5623
RADARR_TAG=release-6.4.4.10685
SONARR_TAG=release-4.0.20.3014
QBITTORRENT_TAG=release-5.2.4
BAZARR_TAG=release-1.6.2
SEERR_TAG=v3.5.0
FLARESOLVERR_TAG=v3.5.2
RECYCLARR_TAG=8.7.2
